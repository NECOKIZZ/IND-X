{
  "name": "ind-x",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:program": "anchor build && node scripts/copy-idl.mjs",
    "test": "vitest run",
    "test:program": "vitest run tests/program",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "server": "tsx --env-file-if-exists=.env server/src/api/main.ts",
    "keeper": "tsx --env-file-if-exists=.env server/src/keeper/cli.ts",
    "dev": "LEAGUE_CLUSTER=lite LEAGUE_SCHEDULE=demo:10:20 tsx --env-file-if-exists=.env server/src/api/main.ts",
    "deploy:localnet": "tsx scripts/deploy.ts localnet",
    "deploy:devnet": "tsx scripts/deploy.ts devnet",
    "deploy:mainnet": "tsx scripts/deploy.ts mainnet",
    "validator": "scripts/local-validator.sh",
    "bots": "tsx scripts/bots.ts"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.1",
    "@indx/core": "workspace:*",
    "@indx/server": "workspace:*",
    "@solana/spl-token": "~0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.20.5",
    "bs58": "^6.0.0",
    "litesvm": "^1.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
