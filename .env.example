# Which chain: mainnet | devnet | localnet | lite (in-process LiteSVM, no validator)
LEAGUE_CLUSTER=lite
# RPC_URL=https://api.devnet.solana.com
# PUBLIC_RPC_URL=                      # RPC the app may use directly
# DEPLOYMENT_FILE=deployments/devnet.json

# Keeper (and test-token faucet on devnet/localnet)
# KEEPER_KEYPAIR=~/.config/solana/keeper.json
# FAUCET_KEYPAIR=~/.config/solana/id.json
# LEAGUE_RUN_KEEPER=1                  # run the keeper inside the API process

# Rounds: weekly (Mon 9:30am → Fri 4pm New York) or demo:<entry min>:<run min>
LEAGUE_SCHEDULE=demo:10:20
LEAGUE_STAKE_USD=5
# LEAGUE_SAMPLES=3
# LEAGUE_SAMPLE_EVERY_MIN=5
# LEAGUE_WINDOW_MIN=30
# LEAGUE_TRACK_MIN=60

# Prices: jupiter (default) | pyth (needs PYTH_API_KEY) | demo
# LEAGUE_PRICE_SOURCE=jupiter
# JUPITER_API_KEY=
# PYTH_API_KEY=

# Storage: Postgres if set, else JSON files in LEAGUE_DATA_DIR
# DATABASE_URL=postgres://...
# LEAGUE_DATA_DIR=data

# Push notifications (Expo)
# EXPO_ACCESS_TOKEN=
# PUSH_DISABLED=1
PORT=8787
